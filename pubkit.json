{
  "kind": "rust",
  "bin": "pubrel",
  "exceptions": [
    {
      "rule": "RS-TEST-01",
      "reason": "no test vectors yet: the version arithmetic and the files pubrel reads need cases from an independent source, such as Cargo's documented SemVer rules, generated outside pubrel",
      "until": "2027-01-12"
    }
  ],
  "ci": {
    "cron": "41 3 * * *",
    "with": {
      "pub-version": "v0.2.1"
    },
    "release": {
      "uses": "local"
    }
  },
  "security": {"sonar": {"args": "-Dsonar.issue.ignore.multicriteria=pubkitpins -Dsonar.issue.ignore.multicriteria.pubkitpins.ruleKey=githubactions:S7637 -Dsonar.issue.ignore.multicriteria.pubkitpins.resourceKey=.github/workflows/*.yml"}},
  "protect": {
    "checks": [
      "ci / passed",
      "release / release",
      "SonarCloud Code Analysis"
    ]
  }
}
