{
  "kind": "rust",
  "bin": "pubrel",
  "exceptions": [
    {
      "rule": "RS-TEST-01",
      "reason": "no test vectors yet: the version arithmetic and the files pubrel reads need cases from an independent source, such as Cargo's documented SemVer rules, generated outside pubrel",
      "until": "2027-01-12"
    }
  ],
  "ci": {
    "cron": "41 3 * * *",
    "release": {
      "uses": "local"
    },
    "tools": [
      {
        "crate": "publet-cli",
        "git": "https://github.com/Sustenaut/publet",
        "tag": "v0.2.3"
      }
    ]
  },
  "protect": {
    "checks": [
      "ci / passed",
      "release / release",
      "SonarCloud Code Analysis"
    ]
  },
  "nightly": {
    "pins": {
      "crates": [
        "publet-core"
      ]
    }
  }
}
